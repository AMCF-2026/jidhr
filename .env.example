# Jidhr environment variables — template only.
# Copy to .env and fill in the required values. NEVER commit .env (.gitignore).
#
# Uncommented + empty  = required, you must supply a value.
# Commented out (# VAR=) = optional, the default shown in the comment is used.

# =============================================================================
# REQUIRED SECRETS
# =============================================================================

# Flask session signing key (config.py). No default: app.py refuses to start
# without it, because a shared or guessable key lets anyone forge a login
# session. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# OpenRouter API key for Claude access (config.py)
OPENROUTER_API_KEY=

# HubSpot Private App access token (config.py)
HUBSPOT_ACCESS_TOKEN=

# CSuite API key + HMAC signing secret (config.py)
CSUITE_API_KEY=
CSUITE_API_SECRET=

# Google OAuth credentials for sign-in (config.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres connection string (clients/database.py). Without it the app runs
# but every database-backed feature raises.
DATABASE_URL=

# Shared token guarding the /sync webhook (app.py). app.py compares against
# os.environ.get('SYNC_SECRET_TOKEN', ''), so leaving this unset leaves the
# webhook effectively open — set it.
SYNC_SECRET_TOKEN=

# =============================================================================
# OPTIONAL — defaults shown, uncomment only to override
# =============================================================================

# DEBUG=False
# PORT=5000

# CLAUDE_MODEL=anthropic/claude-sonnet-4.6

# CSUITE_BASE_URL=https://amuslimcf.fcsuite.com/api/v2

# ALLOWED_DOMAIN=amuslimcf.org

# =============================================================================
# DAF / Endowment inquiry workflow
# =============================================================================
# Three independent switches, each failing closed. Only the exact string "true"
# turns a flag on; anything else, including a typo, is off.

# CSUITE_DAF_CREATE_ENABLED=true          # create the CSuite profile
# CSUITE_DAF_TASK_CREATE_ENABLED=true     # create the follow-up task
# CSUITE_DAF_FUND_CREATE_ENABLED=true     # open the fund — NOT at inquiry
# CSUITE_HUBSPOT_BACKFILL_ENABLED=true    # fill a returning donor's empty link
# CSUITE_TICKET_CLOSE_ENABLED=true        # close the donor's HubSpot ticket

# Nightly DAF intake (V5.90), run by the jobs service after registrations.
# Needs SCHEDULED_SYNC_ENABLED=true like the rest of the nightly run.
#   JIDHR_DAF_MODE   preview (default) reads only and emails what it WOULD
#                    do; live writes, exactly as "new daf" does, and also
#                    needs CSUITE_DAF_CREATE_ENABLED, CSUITE_DAF_TASK_CREATE_
#                    ENABLED and CSUITE_TASK_EMPLOYEE_ID_DAF_INQUIRY.
#   JIDHR_DAF_SINCE  only submissions on or after this date (YYYY-MM-DD).
#                    Unset = the step does nothing.
#   JIDHR_DAF_REPORT_TO  comma-separated recipients. Unset = no email.
JIDHR_DAF_MODE=preview
JIDHR_DAF_SINCE=
JIDHR_DAF_REPORT_TO=

# Endowment inquiries have their OWN switch (V5.81). The DAF switches above do
# not reach "new endowment". Off refuses before anything is read.
CSUITE_ENDOWMENT_CREATE_ENABLED=false

# Endowment follow-up task assignee (V5.81). BLANK until Carl confirms in the
# CSuite UI that employee 1002 is Mohamed, Ola. Blank means endowment create
# refuses with "assignee not confirmed". It replaced
# CSUITE_TASK_EMPLOYEE_ID_ENDOWMENT_INQUIRY, which nothing reads since V5.82 —
# remove it from any deployment that still sets it.
CSUITE_ENDOWMENT_ASSIGNEE=

# "sync donations" writes five properties per matched contact, including
# csuite_profile_id — the field the DAF duplicate guard reads. It repoints it
# on every matched contact without reading what was there, and it is uncapped:
# CSUITE_WRITE_BUDGET governs CSuite writes and says nothing about a HubSpot
# PATCH. A DRY RUN is NOT gated by this and writes nothing.
# CSUITE_DONATION_SYNC_ENABLED=true        # let "sync donations" write

# A hard cap on CSuite writes per client. 0 means nothing can be written.
# A WHOLE NUMBER only (e.g. 10). Anything else — true, 1.5, -3 — is read as 0
# by the chat, and the nightly DAF step refuses it with an [Jidhr ALERT].
# One inquiry costs 2 (profile + task), or 1 for a returning donor.
# CSUITE_WRITE_BUDGET=2

# Follow-up task assignee, PER FORM. No default and no fallback: a form with no
# assignee gets no task, and says so. These are CSuite employee_id values, NOT
# profile ids — an employee has both, and a profile id here would assign the
# task to nothing. (Endowment's is CSUITE_ENDOWMENT_ASSIGNEE, above.)
#
#   1012  production value, identity pending UI check
#   1004  Moorefield, Nora   VERIFIED in production (task/display, 2026-10-02)
#   1002  believed to be Mohamed, Ola: read from the CSuite admin UI by Carl on
#         2026-10-02, re-confirmation requested 2026-10-14 before
#         CSUITE_ENDOWMENT_ASSIGNEE is set. Not API-verifiable: no production
#         task carries it, and the employee endpoints 404 for every id.
#   1007  Zouita, Kods       VERIFIED in production
#   1006  Dodge, Carl        sandbox only; NOT present in production
#
# The DAF value is 1012, which is what production runs (every live DAF
# follow-up task, 1033-1038, is assigned to it). This file said 1004 until
# V5.82.
CSUITE_TASK_EMPLOYEE_ID_DAF_INQUIRY=1012

# CSuite task type. Unset omits the field entirely.
#   1065  "DIY Form-Contact"  — CONFIRMED in production: every live DAF
#         follow-up task (1033-1038) carries it, and task 1038 reads back
#         task_type "DIY Form-Contact". The endowment row uses 1065 fixed.
CSUITE_TASK_TYPE_ID=1065
